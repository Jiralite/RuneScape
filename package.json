{
	"name": "runescape",
	"version": "0.14.7",
	"description": "A library to interact with the RuneScape API.",
	"keywords": [
		"Jagex",
		"RS3",
		"RuneScape"
	],
	"license": "MIT",
	"author": "Jiralite",
	"contributors": [
		"MDaffyduck"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Jiralite/RuneScape.git"
	},
	"files": [
		"distribution"
	],
	"type": "module",
	"types": "./distribution/index.d.ts",
	"exports": "./distribution/index.js",
	"scripts": {
		"build": "tsup",
		"format": "oxlint --fix . && oxfmt .",
		"lint": "oxfmt --check . && oxlint .",
		"lint:ci": "oxfmt --check . && oxlint --format=github .",
		"prepack": "pnpm run build && pnpm run lint",
		"test": "tsc --noEmit && vitest run",
		"update": "pnpm update --interactive --latest && pre-commit autoupdate"
	},
	"dependencies": {
		"csv-parse": "^7.0.3"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@typescript/native": "npm:typescript@^7.0.2",
		"oxfmt": "0.76.0",
		"oxlint": "1.91.0",
		"oxlint-tsgolint": "7.0.2005",
		"tsup": "^9.0.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vitest": "^5.1.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.16.1",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": ">=26",
			"onFail": "error"
		}
	}
}
